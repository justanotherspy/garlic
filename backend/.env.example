# Copy to `.env` and edit. Used by docker-compose.yml.

# Comma-separated bearer tokens. Each token is one isolated user namespace, so
# every agent/environment that should share state uses the SAME token as its
# GARLIC_TOKEN. Generate a strong one with:  openssl rand -hex 32
GARLIC_AUTH_TOKENS=replace-me-with-a-long-random-token

# Timezone that defines the daily reset boundary (reset_hour) for ALL clients
# sharing this backend, e.g. Europe/London, America/New_York. Default: UTC.
TZ=UTC

# Log verbosity: error | warn | info | debug | trace
RUST_LOG=info

# Only needed for the optional `tls` (Caddy) profile — your public domain.
# GARLIC_DOMAIN=garlic.example.com
